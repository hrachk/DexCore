pragma solidity ^0.8.26;

import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";

/**
 * @title ZKCredentialVerifier
 * @notice Skeleton verifier for Groth16 / Plonk-style ZK credentials.
 *         In production the verifying key and pairing checks are generated
 *         from a Circom / snarkjs / gnark circuit that proves:
 *         "holder possesses a valid institutional attestation without revealing identity".
 *
 *         This contract stores attestations issued by a trusted Attestor role
 *         and exposes a verify() that accepts a proof blob + public inputs.
 */
contract ZKCredentialVerifier is AccessControl {
    bytes32 public constant ATTESTOR_ROLE = keccak256("ATTESTOR_ROLE");
    bytes32 public constant VERIFIER_ADMIN_ROLE = keccak256("VERIFIER_ADMIN_ROLE");

    /// @notice commitment => valid until timestamp (0 = revoked / never issued)
    mapping(bytes32 => uint256) public attestationExpiry;

    /// @notice Simple nullifier set to prevent proof replay
    mapping(bytes32 => bool) public usedNullifiers;

    /// @notice Optional verifying key hash (set by admin after circuit deploy)
    bytes32 public verifyingKeyHash;

    event AttestationIssued(bytes32 indexed commitment, uint256 expiresAt, address attestor);
    event AttestationRevoked(bytes32 indexed commitment);
    event ProofVerified(bytes32 indexed commitment, bytes32 nullifier, address caller);
    event VerifyingKeyUpdated(bytes32 oldHash, bytes32 newHash);

    error AttestationExpiredOrMissing();
    error NullifierAlreadyUsed();
    error InvalidProof();
    error ZeroValue();

    constructor(address admin) {
        _grantRole(DEFAULT_ADMIN_ROLE, admin);
        _grantRole(ATTESTOR_ROLE, admin);
        _grantRole(VERIFIER_ADMIN_ROLE, admin);
    }

    /**
     * @notice Attestor issues a credential commitment for an institutional participant.
     * @param commitment Poseidon / Pedersen commitment to identity attributes
     * @param expiresAt Unix timestamp
     */
    function issueAttestation(bytes32 commitment, uint256 expiresAt) external onlyRole(ATTESTOR_ROLE) {
        if (commitment == bytes32(0) || expiresAt <= block.timestamp) revert ZeroValue();
        attestationExpiry[commitment] = expiresAt;
        emit AttestationIssued(commitment, expiresAt, msg.sender);
    }

    function revokeAttestation(bytes32 commitment) external onlyRole(ATTESTOR_ROLE) {
        attestationExpiry[commitment] = 0;
        emit AttestationRevoked(commitment);
    }

    /**
     * @notice Verify a ZK proof that the caller knows a valid attestation.
     * @param commitment Public commitment that must be active
     * @param nullifier Unique nullifier derived from identity + context (prevents replay)
     * @param proof Opaque proof bytes (Groth16 proof = 8 field elements, etc.)
     * @param publicInputs Additional public inputs required by the circuit
     * @return true if proof is accepted
     *
     * @dev Production: replace the length/hash check with a real pairing verifier
     *      generated by snarkjs / circom / gnark.
     */
    function verify(
        bytes32 commitment,
        bytes32 nullifier,
        bytes calldata proof,
        uint256[] calldata publicInputs
    ) external returns (bool) {
        if (attestationExpiry[commitment] == 0 || block.timestamp > attestationExpiry[commitment]) {
            revert AttestationExpiredOrMissing();
        }
        if (usedNullifiers[nullifier]) revert NullifierAlreadyUsed();
        if (proof.length < 64) revert InvalidProof(); // minimal size guard

        // Skeleton verification: in production call the generated verifier contract.
        // Here we accept proofs that hash to a non-zero value and match commitment in publicInputs[0] if present.
        bytes32 proofHash = keccak256(proof);
        if (proofHash == bytes32(0)) revert InvalidProof();

        if (publicInputs.length > 0 && bytes32(publicInputs[0]) != commitment) {
            revert InvalidProof();
        }

        usedNullifiers[nullifier] = true;
        emit ProofVerified(commitment, nullifier, msg.sender);
        return true;
    }

    function isAttestationValid(bytes32 commitment) external view returns (bool) {
        uint256 exp = attestationExpiry[commitment];
        return exp != 0 && block.timestamp <= exp;
    }

    function setVerifyingKeyHash(bytes32 newHash) external onlyRole(VERIFIER_ADMIN_ROLE) {
        bytes32 old = verifyingKeyHash;
        verifyingKeyHash = newHash;
        emit VerifyingKeyUpdated(old, newHash);
    }
}
