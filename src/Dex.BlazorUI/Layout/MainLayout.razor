@inherits LayoutComponentBase
@using Dex.BlazorUI.Services
@inject MetamaskInteropService Wallet
@inject LiveMarketDataService Market
@implements IDisposable

<div class="app-shell">
    <header class="top-nav">
        <a class="brand" href="/trade/BTC-USDT">
            <span class="brand-icon">DX</span>
            DexCore
        </a>
        <span class="live-badge"><span class="dot"></span> LIVE</span>
        <nav class="nav-links">
            <NavLink href="/trade/BTC-USDT" Match="NavLinkMatch.Prefix">Trade</NavLink>
            <NavLink href="/markets">Markets</NavLink>
            <NavLink href="/portfolio">Portfolio</NavLink>
            <NavLink href="/vault">Vault</NavLink>
        </nav>
        <div class="nav-spacer"></div>
        <div class="nav-actions">
            <span class="nav-status">@Market.StatusMessage</span>
            @if (Wallet.IsConnected)
            {
                <button class="btn-wallet connected" @onclick="Disconnect">@(Wallet.Account![..6])…@(Wallet.Account[^4..])</button>
            }
            else
            {
                <button class="btn-wallet" @onclick="Connect">Connect Wallet</button>
            }
        </div>
    </header>
    <div class="page-body">
        @Body
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Wallet.StateChanged += Refresh;
        Market.UiRefreshRequested += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private async Task Connect()
    {
        try
        {
            if (!await Wallet.IsMetaMaskAvailableAsync()) return;
            await Wallet.ConnectAsync();
        }
        catch { /* user rejected */ }
    }

    private async Task Disconnect() => await Wallet.DisconnectAsync();

    public void Dispose()
    {
        Wallet.StateChanged -= Refresh;
        Market.UiRefreshRequested -= Refresh;
    }
}
